# HexBrief settings for the official MISP/misp-docker compose file.
# scripts/misp-up.ps1 copies this to docker/misp/.env.misp (git-ignored) and fills
# every __replace_me__ with a generated secret. Never commit .env.misp.

# --- Pinned versions (checked 2026-11-14; see ADR-003) ---
CORE_TAG=v2.5.51
CORE_RUNNING_TAG=v2.5.51
MODULES_TAG=v3.1.4
MODULES_RUNNING_TAG=v3.1.4
GUARD_TAG=v1.4.1

# --- Access: HTTPS on 127.0.0.1:8443 only (compose.override.yml) ---
BASE_URL=https://127.0.0.1:8443
DISABLE_IPV6=true
TZ=Asia/Kuala_Lumpur

# --- First admin (generic lab identity, no personal data) ---
ADMIN_EMAIL=admin@hexbrief.lab
ADMIN_ORG=HexBrief Lab
ADMIN_PASSWORD=__replace_me__
ADMIN_KEY=__replace_me__
DISABLE_PRINTING_PLAINTEXT_CREDENTIALS=true

# --- Generated secrets (never use upstream defaults like "example") ---
MYSQL_PASSWORD=__replace_me__
MYSQL_ROOT_PASSWORD=__replace_me__
REDIS_PASSWORD=__replace_me__
ENCRYPTION_KEY=__replace_me__
GPG_PASSPHRASE=__replace_me__
SUPERVISOR_PASSWORD=__replace_me__

# --- Lab sizing (ADR-001: ~6 GB host RAM free) ---
INNODB_BUFFER_POOL_SIZE=512M
INNODB_LOG_FILE_SIZE=128M
PHP_MEMORY_LIMIT=1024M
PHP_FCGI_CHILDREN=3

# --- Feed schedule: MISP's scheduler fetches/caches enabled feeds every 24 h while
# MISP is running. Because MISP runs on demand, the Phase 7 daily job starts it,
# fetches, and stops it again (ADR-003).
FETCH_FEED_INTERVAL=86400
CACHE_FEED_INTERVAL=86400
