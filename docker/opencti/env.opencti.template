# HexBrief OpenCTI settings. scripts/opencti-up.ps1 copies this to
# docker/opencti/.env.opencti (git-ignored) and generates every __replace_me__.
# Feed keys (OTX_API_KEY), MISP_API_KEY and TAXII_* are read from the repo .env.

ELASTIC_MEMORY_SIZE=2g

OPENCTI_ADMIN_EMAIL=admin@hexbrief.lab
OPENCTI_ADMIN_PASSWORD=__replace_me__
OPENCTI_ADMIN_TOKEN=__replace_me__
OPENCTI_ENCRYPTION_KEY=__replace_me__
OPENCTI_HEALTHCHECK_ACCESS_KEY=__replace_me__

MINIO_ROOT_USER=hexbrief
MINIO_ROOT_PASSWORD=__replace_me__
RABBITMQ_DEFAULT_USER=hexbrief
RABBITMQ_DEFAULT_PASS=__replace_me__

# Connector ids (UUIDv4, generated once and kept so state survives restarts)
CONNECTOR_MITRE_ID=__replace_me__
CONNECTOR_KEV_ID=__replace_me__
CONNECTOR_OTX_ID=__replace_me__
CONNECTOR_THREATFOX_ID=__replace_me__
CONNECTOR_URLHAUS_ID=__replace_me__
CONNECTOR_MISP_ID=__replace_me__
CONNECTOR_TAXII2_ID=__replace_me__

# Lab history limits
OTX_PULSE_START=2026-11-01T00:00:00
MISP_IMPORT_FROM=2026-01-01
