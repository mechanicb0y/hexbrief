{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HexBrief LLM narrative v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["bluf", "top_threats", "trends", "education_asean_watch", "confidence_note"],
  "properties": {
    "bluf": {"type": "string", "minLength": 20, "maxLength": 900},
    "top_threats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_ids", "headline", "why_it_matters", "actions"],
        "properties": {
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "pattern": "^F[0-9]{1,3}$"}
          },
          "headline": {"type": "string", "minLength": 5, "maxLength": 140},
          "why_it_matters": {"type": "string", "minLength": 10, "maxLength": 600},
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "minLength": 5, "maxLength": 220}
          }
        }
      }
    },
    "trends": {"type": "string", "maxLength": 700},
    "education_asean_watch": {"type": "string", "maxLength": 700},
    "confidence_note": {"type": "string", "maxLength": 400}
  }
}
