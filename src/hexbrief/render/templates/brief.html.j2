<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
<meta name="referrer" content="no-referrer">
<title>HexBrief {{ day }}</title>
<style>
:root { --bg:#f7f7f5; --fg:#1b1d1f; --muted:#5d6166; --line:#d9dad6; --card:#fff; --accent:#0f766e;
        --clear:#e9f7ef; --clear-fg:#14532d; --warn:#fff4e5; --warn-fg:#7c2d12; }
@media (prefers-color-scheme: dark) { :root { --bg:#111315; --fg:#e7e7e4; --muted:#a2a6aa; --line:#2b2e31;
        --card:#181b1d; --accent:#2dd4bf; --clear:#0f2a1c; --clear-fg:#86efac; --warn:#2a1a0b; --warn-fg:#fdba74; } }
* { box-sizing:border-box } body { margin:0; background:var(--bg); color:var(--fg);
  font:16px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif }
main { max-width:860px; margin:0 auto; padding:24px 16px 64px }
h1 { font-size:1.6rem; margin:.2em 0 } h2 { font-size:1.15rem; margin:2em 0 .6em; border-bottom:1px solid var(--line); padding-bottom:.3em }
h3 { font-size:1.02rem; margin:1.4em 0 .3em }
.tlp { display:inline-block; padding:.2em .7em; border-radius:4px; font-weight:700; letter-spacing:.03em }
.tlp.clear { background:var(--clear); color:var(--clear-fg) } .tlp.other { background:var(--warn); color:var(--warn-fg) }
.meta, .muted { color:var(--muted); font-size:.92rem }
.card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:12px 16px; margin:12px 0 }
.bluf { border-left:4px solid var(--accent) }
code, .ioc { font-family:ui-monospace,SFMono-Regular,Consolas,monospace; font-size:.88em; word-break:break-all }
table { width:100%; border-collapse:collapse; font-size:.92rem } th, td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--line); vertical-align:top }
.tags span { display:inline-block; border:1px solid var(--line); border-radius:999px; padding:0 .55em; margin:2px; font-size:.82rem }
a { color:var(--accent) }
</style>
</head>
<body><main>
<p><span class="tlp {{ 'clear' if tlp == 'TLP:CLEAR' else 'other' }}">{{ tlp }}</span>
<span class="meta">{% if tlp == "TLP:CLEAR" %}May be shared publicly.{% else %}Limited distribution. Do not publish.{% endif %}</span></p>
<h1>HexBrief daily threat brief: {{ day }}</h1>
<p class="meta">Window {{ window_start }} → {{ window_end }} (Asia/Kuala_Lumpur) · generated {{ generated }}</p>

<h2>Bottom line up front</h2>
<div class="card bluf">{{ narrative.bluf }}</div>

<h2>Top threats</h2>
{% for t in narrative.top_threats %}
<div class="card">
<h3>{{ loop.index }}. {{ t.headline }}</h3>
<p class="muted">Findings: {% for fid in t.finding_ids %}<a href="#{{ fid | lower }}">{{ fid }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
<p>{{ t.why_it_matters }}</p>
<strong>Recommended actions</strong>
<ul>{% for a in t.actions %}<li>{{ a }}</li>{% endfor %}</ul>
</div>
{% endfor %}

<h2>New CISA KEV entries</h2>
{% if kev %}<table><tr><th>CVE</th><th>Vulnerability</th><th>Ransomware</th></tr>
{% for k in kev %}<tr><td><code>{{ k.cve }}</code></td><td>{{ k.title }}</td><td>{{ "known" if k.ransomware else "" }}</td></tr>{% endfor %}
</table>{% else %}<p class="muted">No new KEV entries in this window.</p>{% endif %}

<h2>ATT&amp;CK techniques seen</h2>
{% if techniques %}<p class="tags">{% for tid, n in techniques %}<span><code>{{ tid }}</code> ×{{ n }}</span>{% endfor %}</p>
{% else %}<p class="muted">None mapped in this window.</p>{% endif %}

<h2>Education and Malaysia/ASEAN watch</h2>
<div class="card">{{ narrative.education_asean_watch }}</div>

<h2>Trends</h2>
<p>{{ narrative.trends or "Nothing notable today." }}</p>

<h2>Findings</h2>
{% for f in top %}
<div class="card" id="{{ f.fid | lower }}">
<h3>{{ f.fid }}: {{ f.title }}</h3>
<p class="muted">Score {{ f.score }}: {{ f.reasons | join(", ") }}<br>
Sources: {{ f.sources | join(", ") }} · {{ f.tlp }} · confidence {{ f.confidence }}</p>
{% if f.cves %}<p>CVEs: {% for c in f.cves %}<code>{{ c }}</code> {% endfor %}</p>{% endif %}
{% if f.attack_ids %}<p>ATT&amp;CK: {% for a in f.attack_ids %}<code>{{ a }}</code> {% endfor %}</p>{% endif %}
{% if f.summary %}<p>{{ f.summary }}</p>{% endif %}
</div>
{% endfor %}

<h2>IOC appendix (defanged)</h2>
{% if iocs %}<table><tr><th>Finding</th><th>Type</th><th>Indicator</th></tr>
{% for row in iocs %}<tr><td>{{ row.fid }}</td><td>{{ row.type }}</td><td class="ioc">{{ row.value }}</td></tr>{% endfor %}
</table>{% if iocs_truncated %}<p class="muted">{{ iocs_truncated }} more indicators are in brief.json / brief.stix.json.</p>{% endif %}
{% else %}<p class="muted">No indicators in the top findings.</p>{% endif %}

<h2>Sources</h2>
<ul>{% for s in sources %}<li>{{ s }}</li>{% endfor %}</ul>

<h2>Method</h2>
<p class="muted">{{ method_note }} Ranking is rule-based: KEV, exploitation, recency, independent sources, confidence, education/Malaysia/ASEAN relevance, and warninglist hits. {{ others_count }} lower-ranked findings are listed in brief.json.</p>
</main></body></html>
