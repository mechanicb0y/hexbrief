# HexBrief configuration — PLACEHOLDERS ONLY.
# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Admin passwords and encryption keys will be generated by scripts/gen-secrets (Phase 2/3), never typed by hand.

# --- General ---
HEXBRIEF_TZ=Asia/Kuala_Lumpur
HEXBRIEF_WINDOW_HOURS=24
HEXBRIEF_TOP_N=8

# --- Feed keys (free sign-ups, Phase 0) ---
OTX_API_KEY=__replace_me__
ABUSECH_AUTH_KEY=__replace_me__

# --- MISP (Phase 2) ---
MISP_URL=https://127.0.0.1:8443
MISP_API_KEY=__replace_me__
MISP_VERIFY_SSL=false

# --- OpenCTI (Phase 3) ---
OPENCTI_URL=http://127.0.0.1:8080
OPENCTI_TOKEN=__replace_me__

# --- TAXII 2.1 server / medallion (Phase 1) ---
TAXII_URL=http://127.0.0.1:5000/taxii2/
TAXII_USER=__replace_me__
TAXII_PASSWORD=__replace_me__

# --- Local LLM / Ollama (Phase 4) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Optional webhook (Phase 6) ---
WEBHOOK_URL=
